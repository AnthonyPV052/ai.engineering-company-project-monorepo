# =============================================================================
# Brasaland Supplier Directory — Variables de Entorno Requeridas
# =============================================================================
# Copia este archivo como .env y completa los valores.
#   cp .env.example .env
# =============================================================================

# --- Base de datos (PostgreSQL/Supabase) ---
DATABASE_URL=postgresql://user:password@host:5432/brasaland

# --- JWT ---
JWT_SECRET_KEY=changeme-to-a-secure-random-string-at-least-32-chars

# --- Redis ---
REDIS_PASSWORD=changeme-to-a-strong-redis-password

# --- Flower (monitoreo Celery) ---
FLOWER_USER=admin
FLOWER_PASSWORD=changeme-to-a-strong-flower-password

# --- LLM / Agente ---
LLM_GATEWAY=https://your-llm-gateway.example.com
LLM_API_KEY=sk-your-api-key
EMBED_MODEL=text-embedding-3-small
# GEN_MODEL tiene un valor por defecto en docker-compose.yml

# --- Qdrant (vector store) ---
# QDRANT_URL tiene un valor por defecto en docker-compose.yml

# --- Telemetría (opcional) ---
# TELEMETRY_ENDPOINT=https://your-telemetry-endpoint.example.com/events
